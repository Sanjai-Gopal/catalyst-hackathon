# CareNest AI environment template. Copy to .env.local for local development.

# --- Browser-safe (exposed in the bundle; contains NO secrets) ---
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6af86666003a589a4773
VITE_APPWRITE_DATABASE_ID=6af86b4100238c0101ef

# --- Server-only secrets (set in Vercel > Project > Settings > Environment Variables).
# NEVER prefix these with VITE_ or they will leak into the public JavaScript bundle. ---
GEMINI_API_KEY=your_gemini_api_key_here
RESEND_API_KEY=your_resend_api_key_here
# Required: comma-separated exact site origins allowed to call server endpoints
APP_ALLOWED_ORIGINS=http://localhost:5173,https://catalyst-hackathon-lime.vercel.app
# Required: comma-separated recipients the email relay is allowed to contact
ALLOWED_EMAIL_RECIPIENTS=family@example.com
