# CareNest AI environment template.

# --- Public (safe to ship to the browser; these are identifiers, not secrets) ---
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id

# --- SERVER ONLY (set in Vercel Project Settings > Environment Variables) ---
# Never prefix these with VITE_: anything with that prefix is bundled into public JS.
GEMINI_API_KEY=
RESEND_API_KEY=
# Verified Resend sender, e.g. "CareNest AI <alerts@your-domain.com>".
# Without a verified domain Resend only delivers to your own account email.
EMAIL_FROM=
# Appwrite API key (server-only) used by the cron reminder function.
APPWRITE_API_KEY=
# Shared secret that Vercel Cron sends to /api/cron/* so only Vercel can trigger them.
CRON_SECRET=
